# Use TWITCH_CHANNEL for one channel, or TWITCH_CHANNELS for a comma-separated list.
TWITCH_CHANNEL=theprimeagen
# TWITCH_CHANNELS=theprimeagen,another_channel
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional if app token doesn't list subscriber-only VODs.
# TWITCH_USER_OAUTH_TOKEN=your_user_token
#
# Optional device-code token helper
# TWITCH_SCOPES=
# TOKEN_PATH=/data/twitch_token.json
COOKIES_PATH=/data/cookies.txt
OUTPUT_DIR=/data/vods
# Single channel: a JSON file. Multiple channels: preferably a directory.
# STATE_PATH=/data/state.json
SHOW_NAME=Primeagen
# SHOW_NAMES=Primeagen,Another Show
# LOCK_PATH=/data/vods/.vodsaver.lock
# YTDLP_EXTRA_ARGS=--concurrent-fragments 4
